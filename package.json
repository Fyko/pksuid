{
  "name": "pksuid",
  "version": "0.1.20",
  "description": "Prefixed, k-sortable, strictly-typed ids in the style of Stripe object ids",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint -c oxlint.config.mjs",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run type-check"
  },
  "keywords": [
    "ksuid",
    "prefixed-id",
    "stripe-id",
    "uuid",
    "identifier",
    "sortable",
    "timestamp",
    "unique"
  ],
  "author": "Carter Himmel",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.2.0",
    "eslint-config-neon": "^0.5.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/fyko/pksuid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyko/pksuid.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  }
}
