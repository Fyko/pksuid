{
  "name": "pksuid",
  "version": "0.1.20",
  "description": "Prefixed, k-sortable, strictly-typed ids in the style of Stripe object ids",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "uvu test",
    "test:unit": "uvu test/unit",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint -c oxlint.config.mjs",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run type-check"
  },
  "keywords": [
    "ksuid",
    "prefixed-id",
    "stripe-id",
    "uuid",
    "identifier",
    "sortable",
    "timestamp",
    "unique"
  ],
  "author": "Carter Himmel",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "base-x": "^5.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^26.2.0",
    "eslint-config-neon": "^0.5.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "uvu": "^0.5.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/fyko/ksuid"
}
