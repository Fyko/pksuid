{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": false,
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "build/",
    "coverage/",
    "node_modules/",
    "tools/oxlint/anti-slop/",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "*.d.ts.map",
    "*.js.map",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    ".vscode/",
    ".idea/",
    ".DS_Store",
    "Thumbs.db",
    "*.lcov",
    "*.tmp",
    "*.temp",
    "docs/_build/"
  ]
}
